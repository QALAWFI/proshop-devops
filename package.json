{
  "name": "proshop",
  "version": "2.0.0",
  "private": true,
  "description": "ProShop eCommerce platform - MERN stack (backend + frontend)",
  "scripts": {
    "server": "npm run dev --prefix backend",
    "client": "npm start --prefix frontend",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "data:import": "npm run data:import --prefix backend",
    "data:destroy": "npm run data:destroy --prefix backend"
  },
  "devDependencies": {
    "concurrently": "^7.6.0"
  }
}
